<PARAMETERS>
Tm, 293.1500, 1
deltaH, 1.500e+05, 1
SN, 1.0000, 1
slopeN, 0, 1
SU, 0, 1
slopeU, 0, 1
deltaCp, 0, 0
<FORMULA>
# thermal denaturation
# (deltaCp is fixed to zero by default as it is hard to experimentally determine)

R = 8.3145
T = x
Tm = Tm
deltaG = deltaH - T / Tm * deltaH + deltaCp * (T - Tm - T * log(T / Tm))
K = exp(-deltaG / R / T)
fN = 1 / (1 + K)
y = fN * (SN + slopeN * (T - Tm)) + (1 - fN) * (SU + slopeU * (T - Tm))
<METADATA>
complexity: 3
